<section class="holo-demo" id="holo" aria-labelledby="holo-title">
  <div class="holo-copy">
    <p class="eyebrow">✦ PRØV SELV! · INTERAKTIV DEMO</p>
    <h2 id="holo-title">Uuuh…<br /><em>se det glimte!</em></h2>
    <p>Grib kortet og drej det rundt. Se lyset skifte i den holografiske overflade, og vend det for at se bagsiden.</p>
    <p id="holo-help" class="help">Træk vandret med mus eller finger. Du kan også bruge piletasterne, når kortet er markeret.</p>
    <div class="controls">
      <button type="button" data-flip>Vend kortet</button>
      <button type="button" data-reset>Nulstil</button>
      <button type="button" data-pause aria-pressed="false">Pause svævning</button>
    </div>
    <p class="disclaimer">Visuel demo med Pokémon Card 151 på forsiden og Packlux-logo på bagsiden. Ikke en gengivelse af pakkens faktiske bagside eller en pakkeåbning.</p>
  </div>
  <div class="viewer">
    <div class="halo" aria-hidden="true"></div>
    <div class="float">
      <button class="card-control" type="button" aria-label="Drej holografisk kort med Mew 151-pack og Packlux-logo" aria-describedby="holo-help">
        <span class="card-model" aria-hidden="true">
          <span class="face front">
            <img class="mew-pack" src="/products/pokemon-151.png" alt="" width="380" height="766" draggable="false" />
          </span>
          <span class="face back">
            <span class="back-border"></span>
            <span class="back-top">THE NEXT DISCOVERY</span>
            <img class="back-logo" src="/packlux-logo.png" alt="" width="1152" height="768" draggable="false" />
            <span class="back-bottom">PACKLUX · VISUEL DEMO</span>
          </span>
        </span>
      </button>
    </div>
    <span class="viewer-caption">TRÆK FOR AT DREJE · 360°</span>
  </div>
</section>

<script>
  const demo = document.querySelector<HTMLElement>('.holo-demo');
  if (demo) {
    const control = demo.querySelector<HTMLButtonElement>('.card-control')!;
    const model = demo.querySelector<HTMLElement>('.card-model')!;
    const flip = demo.querySelector<HTMLButtonElement>('[data-flip]')!;
    const reset = demo.querySelector<HTMLButtonElement>('[data-reset]')!;
    const pause = demo.querySelector<HTMLButtonElement>('[data-pause]')!;
    let rotation = -18;
    let tilt = 8;
    let drag: { id: number; x: number; y: number; rotation: number; tilt: number } | null = null;

    function render() {
      model.style.setProperty('--rotation', `${rotation}deg`);
      model.style.setProperty('--tilt', `${tilt}deg`);
      model.style.setProperty('--light-x', `${50 + Math.sin(rotation * Math.PI / 180) * 40}%`);
      model.style.setProperty('--light-y', `${50 + tilt}%`);
      model.style.setProperty('--hue', `${rotation}deg`);
    }

    control.addEventListener('pointerdown', (event) => {
      if (!event.isPrimary || event.button !== 0 || drag) return;
      control.setPointerCapture(event.pointerId);
      drag = { id: event.pointerId, x: event.clientX, y: event.clientY, rotation, tilt };
      demo.dataset.dragging = 'true';
    });
    control.addEventListener('pointermove', (event) => {
      if (!drag || drag.id !== event.pointerId) return;
      rotation = drag.rotation + (event.clientX - drag.x) * 0.8;
      tilt = Math.max(-35, Math.min(35, drag.tilt - (event.clientY - drag.y) * 0.25));
      render();
    });
    function endDrag(event: PointerEvent) {
      if (drag?.id !== event.pointerId) return;
      drag = null;
      delete demo!.dataset.dragging;
      if (control.hasPointerCapture(event.pointerId)) control.releasePointerCapture(event.pointerId);
    }
    control.addEventListener('pointerup', endDrag);
    control.addEventListener('pointercancel', endDrag);
    control.addEventListener('lostpointercapture', endDrag);
    function flipCard() {
      rotation += 180;
      render();
    }
    flip.addEventListener('click', flipCard);
    control.addEventListener('click', (event) => {
      if (event.detail === 0) flipCard();
    });
    control.addEventListener('keydown', (event) => {
      if (!['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'Home'].includes(event.key)) return;
      event.preventDefault();
      if (event.key === 'ArrowLeft') rotation -= 15;
      if (event.key === 'ArrowRight') rotation += 15;
      if (event.key === 'ArrowUp') tilt = Math.min(35, tilt + 5);
      if (event.key === 'ArrowDown') tilt = Math.max(-35, tilt - 5);
      if (event.key === 'Home') { rotation = -18; tilt = 8; }
      render();
    });
    reset.addEventListener('click', () => { rotation = -18; tilt = 8; render(); });
    pause.addEventListener('click', () => {
      const paused = pause.getAttribute('aria-pressed') !== 'true';
      pause.setAttribute('aria-pressed', String(paused));
      demo.dataset.paused = String(paused);
      pause.textContent = paused ? 'Genoptag svævning' : 'Pause svævning';
    });
    render();
  }
</script>

<style>
  .holo-demo { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center; padding: 4rem max(1.2rem, calc((100% - 1184px) / 2)); background: radial-gradient(circle, #ffffff12 2px, transparent 3px) 0 0 / 24px 24px, linear-gradient(135deg, #243e94, #3e287b); color: #fff; overflow: hidden; border-top: 4px solid #172b42; }
  .holo-copy { padding: 0 1.8rem; }
  .eyebrow { color: #ffdf57; font-size: .75rem; letter-spacing: .08em; font-weight: 900; }
  h2 { font-size: clamp(2.4rem, 4vw, 3.8rem); line-height: 1.05; letter-spacing: -.05em; margin: 1.3rem 0; font-weight: 900; }
  h2 em { color: #ffdf57; font-style: normal; font-weight: 900; }
  p { color: #e2eaff; max-width: 29rem; }
  .help { font-size: .8rem; }
  .controls { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: 1.5rem; }
  .controls button { border: 2px solid #aebfe8; border-radius: 2rem; padding: .65rem .8rem; background: #1c2b65; color: #fff; font: inherit; font-size: .8rem; font-weight: 800; cursor: pointer; }
  .controls button:hover { background: #273853; }
  .controls button:first-child { background: #ffdf57; color: #172b42; border-color: #172b42; box-shadow: 2px 3px 0 #172b42; }
  button:focus-visible { outline: 3px solid #f4d38b; outline-offset: 6px; }
  .card-control:focus-visible { outline: none; }
  .card-control:focus-visible .face { outline: 3px solid #f4d38b; outline-offset: 3px; }
  .disclaimer { font-size: .65rem; margin-top: 1.5rem; }
  .viewer { min-height: 490px; position: relative; display: grid; place-items: center; perspective: 1000px; }
  .halo { position: absolute; width: min(100%, 440px); aspect-ratio: 1; background: radial-gradient(ellipse, #6253a943, #265b6933 40%, transparent 70%); pointer-events: none; }
  .float { animation: float 6s ease-in-out infinite; transform-style: preserve-3d; }
  .card-control { display: block; width: 260px; height: 370px; border: 0; padding: 0; border-radius: 17px; background: transparent; cursor: grab; touch-action: pan-y; user-select: none; perspective: 1000px; transform-style: preserve-3d; -webkit-tap-highlight-color: transparent; }
  [data-dragging] .card-control { cursor: grabbing; }
  [data-dragging] .float, [data-paused="true"] .float, .viewer:focus-within .float { animation-play-state: paused; }
  .card-model { display: block; position: relative; width: 100%; height: 100%; transform-style: preserve-3d; transform: rotateX(var(--tilt, 8deg)) rotateY(var(--rotation, -18deg)); transition: transform .3s ease-out; }
  [data-dragging] .card-model { transition: none; }
  .face { position: absolute; inset: 0; display: flex; flex-direction: column; border: 7px solid #d5bc76; border-radius: 17px; backface-visibility: hidden; -webkit-backface-visibility: hidden; overflow: hidden; box-shadow: 0 24px 45px #0007; text-align: left; }
  .front { align-items: center; justify-content: center; padding: 8px; background: radial-gradient(ellipse, #ffe2f2, #f8f4ff 70%); transform: translateZ(1px); }
  .mew-pack { display: block; width: 100%; height: 100%; object-fit: contain; pointer-events: none; }
  .face::after { content: ""; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(ellipse at var(--light-x, 40%) var(--light-y, 50%), #ffffff91, transparent 53%), repeating-linear-gradient(115deg, #ffbc5840 0%, #86f8dc50 12%, #8aa7ff55 24%, #f9b9ff50 36%, #ffbc5840 48%); background-size: 100% 100%, 220% 220%; background-position: center, var(--light-x, 40%) var(--light-y, 50%); mix-blend-mode: screen; opacity: .65; filter: hue-rotate(var(--hue, 0deg)); }
  .back { align-items: center; justify-content: center; gap: 20px; background: repeating-linear-gradient(45deg, #172d48 0 5px, #1d3451 5px 6px); transform: rotateY(180deg) translateZ(1px); }
  .back-border { position: absolute; inset: 12px; border: 1px solid #e6c77e80; border-radius: 5px; }
  .back-top, .back-bottom { font: 7px Arial, sans-serif; letter-spacing: 1.5px; color: #e6c77e; }
  .back-logo { display: block; width: 90%; height: auto; pointer-events: none; }
  .viewer-caption { position: absolute; bottom: 0; color: #e2eaff; font-size: .6rem; letter-spacing: .18em; }
  @keyframes float { 0%, 100% { transform: translateY(0) rotateZ(-3deg); } 50% { transform: translateY(-14px) rotateZ(1deg); } }
  @media (max-width: 760px) {
    .holo-demo { grid-template-columns: minmax(0, 1fr); gap: 1rem; padding-block: 3rem; }
    .holo-copy { padding: 0; }
    .viewer { min-height: 465px; }
    .card-control { width: 240px; height: 350px; }
  }
  @media (prefers-reduced-motion: reduce) { .float { animation: none; } .card-model { transition: none; } }
</style>
